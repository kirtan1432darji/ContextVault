# ContextVault Standalone Web Client Configuration

# FastAPI Backend Base URL (No trailing slash)
# -------------------------------------------------------------
# For Ubuntu Docker Server on Local Network:
# VITE_API_BASE_URL=http://192.168.1.100:8000
#
# For Localhost Development (when testing backend locally):
# VITE_API_BASE_URL=http://localhost:8000
#
# For Production Environment:
# VITE_API_BASE_URL=https://api.contextvault.com

VITE_API_BASE_URL=http://localhost:8000

# Application Metadata
VITE_APP_NAME=ContextVault Web Client
VITE_APP_ENV=development
